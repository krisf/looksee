[Desktop Entry]
Type=Application
Name=Looksee
GenericName=Image Viewer
Comment=Fast dark image viewer with slideshow
Exec=looksee %U
Icon=looksee
Terminal=false
Categories=Graphics;Viewer;
StartupNotify=true
